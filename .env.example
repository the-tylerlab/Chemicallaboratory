# Application Environment Configuration
PORT=3000
NODE_ENV=development

# Production Supabase. Only used when NODE_ENV=production.
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Development Supabase. Use a separate project seeded only with mock data.
# Development ignores SUPABASE_URL and SUPABASE_KEY even if they are present.
SUPABASE_DEV_URL=https://your-development-project.supabase.co
SUPABASE_DEV_KEY=your-development-project-service-role-key

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=8h

# Optional Google Apps Script Integration
GOOGLE_SCRIPT_URL=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@chemlab.local

GOOGLE_LABEL_SHEET_ID=1nyZPEmhXYukJjAYIeBYvH4cO98n_Dsz5AdQKT4PdzsE
