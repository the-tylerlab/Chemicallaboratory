{
  "name": "chemical-laboratory-system",
  "version": "2.7.0",
  "description": "Chemical Laboratory library system and scientific equipment management backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed_demo.js",
    "seed:clean": "node scripts/seed_demo.js --clean",
    "test:security": "node scripts/test_security_suite.js",
    "test:date": "node scripts/test_system_date.js",
    "test:auth": "node scripts/test_auth_domain.js",
    "test:p1-database": "node scripts/test_p1_database.js",
    "test:p2-inventory": "node scripts/test_p2_inventory.js",
    "test:p2-modules": "node scripts/test_p2_modules.js",
    "test:all": "npm run test:security && npm run test:date && npm run test:auth && npm run test:p1-database && npm run test:p2-inventory && npm run test:p2-modules",
    "build:pages": "node scripts/build_pages.js",
    "watch:pages": "node scripts/build_pages.js --watch",
    "build:css": "tailwindcss -i global.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i global.css -o assets/css/tailwind.css --watch",
    "build": "npm run build:pages && npm run build:css && npm run build:agentation",
    "build:agentation": "esbuild src/agentation-entry.js --bundle --minify --outfile=agentation.bundle.js --format=iife --define:process.env.NODE_ENV='\"production\"'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "author": "Antigravity AI",
  "license": "MIT",
  "devDependencies": {
    "agentation": "^3.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19"
  }
}
