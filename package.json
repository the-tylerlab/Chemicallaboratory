{
  "name": "chemical-laboratory-system",
  "version": "2.7.0",
  "description": "Chemical Laboratory library system and scientific equipment management backend",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed_demo.js",
    "seed:clean": "node scripts/seed_demo.js --clean",
    "test:security": "node tests/test_security_suite.js",
    "test:date": "node tests/test_system_date.js",
    "test:auth": "node tests/test_auth_domain.js",
    "test:p1-database": "node tests/test_p1_database.js",
    "test:p2-inventory": "node tests/test_p2_inventory.js",
    "test:p2-modules": "node tests/test_p2_modules.js",
    "test:all": "npm run test:security && npm run test:date && npm run test:auth && npm run test:p1-database && npm run test:p2-inventory && npm run test:p2-modules",
    "verify:data": "node scripts/data/verify_data_integrity.js",
    "backup:data": "node scripts/data/backup_data.js",
    "build:pages": "node scripts/build_pages.js",
    "watch:pages": "node scripts/build_pages.js --watch",
    "build:styles": "node scripts/build_styles.js",
    "build:dashboard-announcement": "node scripts/build_dashboard_announcement.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/global.css -o public/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/styles/global.css -o public/assets/css/tailwind.css --watch",
    "build": "npm run build:pages && npm run build:styles && npm run build:css && npm run build:dashboard-announcement && npm run build:agentation",
    "build:agentation": "esbuild src/agentation-entry.js --bundle --minify --outfile=public/assets/js/agentation.bundle.js --format=iife --define:process.env.NODE_ENV='\"production\"'",
    "sync:label-sheet": "node scripts/sync/sync_to_label_sheet.js"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.3",
    "@astryxdesign/theme-neutral": "^0.7.3",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.110.3",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7"
  },
  "author": "Antigravity AI",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
